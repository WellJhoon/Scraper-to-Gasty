    {
      "name": "5. Comparar Canasta en los 5 Supermercados",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns supermarket ranking and winnerShop', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.ranking.length).to.be.at.least(1);",
              "    pm.expect(jsonData.winnerShop).to.not.be.null;",
              "    if (jsonData.winnerShop) {",
              "        pm.collectionVariables.set('winningShopId', String(jsonData.winnerShop.shopId));",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-app-token",
            "value": "{{appToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshStale\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/lists/{{listId}}/compare",
          "host": ["{{baseUrl}}"],
          "path": ["api", "lists", "{{listId}}", "compare"]
        }
      }
    },
    {
      "name": "6. Activar 'Modo En el Súper' con Supermercado Ganador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 and status is shopping', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('shopping');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-app-token",
            "value": "{{appToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shopId\": {{winningShopId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/lists/{{listId}}/start-shopping",
          "host": ["{{baseUrl}}"],
          "path": ["api", "lists", "{{listId}}", "start-shopping"]
        }
      }
    },
    {
      "name": "7. Tachar Producto en Pasillo y Validar Subtotal",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 and item is checked with subtotal', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.aisleSummary.checkedItems).to.be.at.least(1);",
              "    pm.expect(jsonData.aisleSummary.inCartTotal).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "x-app-token",
            "value": "{{appToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"checked\": true,\n  \"addedBy\": \"Sol\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/lists/{{listId}}/items/{{itemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "lists", "{{listId}}", "items", "{{itemId}}"]
        }
      }
    }
